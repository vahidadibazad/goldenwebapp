# =============================================
# تنظیمات سرور
# =============================================
PORT=3000
NODE_ENV=development

# =============================================
# تنظیمات دیتابیس
# =============================================
MONGODB_URI=mongodb://127.0.0.1:27017/goldenweb

# =============================================
# تنظیمات JWT
# =============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# =============================================
# تنظیمات Redis (اختیاری)
# =============================================
REDIS_URL=redis://localhost:6379

# =============================================
# تنظیمات CORS (تولید)
# =============================================
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# =============================================
# تنظیمات SMTP (ایمیل)
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
SMTP_FROM=your-email@gmail.com

# =============================================
# تنظیمات IMAP (دریافت ایمیل)
# =============================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password

# =============================================
# تنظیمات فکس
# =============================================
FAX_SENDER_NUMBER=02112345678
FAX_INTERNAL_ENDPOINT=
FAX_INTERNAL_API_KEY=
FAX_EXTERNAL_ENDPOINT=
FAX_EXTERNAL_API_KEY=

# =============================================
# تنظیمات پیامک (کاوه‌نگار)
# =============================================
KAVENEGAR_API_KEY=your-kavenegar-api-key
SMS_SENDER=1000596446

# =============================================
# تنظیمات وب‌هوک
# =============================================
WEBHOOK_SECRET=your-webhook-secret-key

# =============================================
# تنظیمات OCR
# =============================================
OCR_API_KEY=your-ocr-api-key

# =============================================
# تنظیمات Elasticsearch
# =============================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=your-elasticsearch-api-key

# =============================================
# تنظیمات Redis
# =============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=