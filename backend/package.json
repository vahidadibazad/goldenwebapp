{
  "name": "goldenwebapp",
  "version": "2.0.0",
  "description": "سیستم یکپارچه مدیریت سازمانی - نسخه نهایی با بهینه‌سازی کامل",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=4096' NODE_ICU_DATA=node_modules/full-icu PYTHONIOENCODING=utf-8 LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 nodemon server.js",
    "dev:host": "cross-env NODE_OPTIONS='--max-old-space-size=4096' NODE_ICU_DATA=node_modules/full-icu PYTHONIOENCODING=utf-8 LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 nodemon server.js --host 0.0.0.0",
    "dev:win": "chcp 65001 > nul && npm run dev",
    "optimize": "node src/scripts/optimizeIndexes.js",
    "cache:clear": "node src/scripts/clearCache.js",
    "seed": "node src/utils/seed.js",
    "index": "node src/scripts/indexDocuments.js",
    "backup": "node src/utils/backup.js"
  },
  "keywords": [
    "management",
    "erp",
    "document",
    "workflow",
    "signature"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elastic/elasticsearch": "^8.11.0",
    "axios": "^1.19.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "kavenegar": "^1.1.4",
    "moment-jalaali": "^0.10.4",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "redis": "^4.6.13",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.4"
  },
  "nodemonConfig": {
    "ignore": [
      "backups/*",
      "uploads/*",
      "node_modules/*",
      "*.json",
      "*.log"
    ],
    "ext": "js,json",
    "delay": 1000
  }
}
